FROM node:22-alpine AS build

WORKDIR /src
COPY dashboard/package*.json ./
RUN npm ci

COPY dashboard/ ./
# Baked in at build time since Vite env vars are compile-time constants;
# override by rebuilding with --build-arg VITE_API_BASE=... for a
# non-default dniip-api location.
ARG VITE_API_BASE=http://localhost:8080
ENV VITE_API_BASE=${VITE_API_BASE}
RUN npm run build

FROM nginx:alpine
COPY --from=build /src/dist /usr/share/nginx/html
# Single-page app: unmatched paths (e.g. /nodes/node-a on a hard refresh)
# fall back to index.html so React Router handles them client-side.
RUN printf 'server {\n\
    listen 80;\n\
    location / {\n\
        root /usr/share/nginx/html;\n\
        try_files $uri /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
