[Unit]
Description=DNIIP telemetry ingestion server (epoll TCP collector + correlation/incident/RCA pipeline)
Documentation=https://github.com/your-org/distributed-network-incident-platform
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
# argv: telemetry_port sqlite_fallback_path (see server/main.cpp)
ExecStart=/usr/local/bin/dniip-server 9000 /var/lib/dniip/server.sqlite
Environment=DNIIP_METRICS_PORT=9100
# Uncomment to use PostgreSQL instead of the interim SQLite store:
# Environment=DNIIP_PG_CONNINFO=host=localhost port=5432 dbname=dniip user=dniip password=CHANGE_ME
Restart=on-failure
RestartSec=5s

User=dniip
Group=dniip
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dniip
StateDirectory=dniip

[Install]
WantedBy=multi-user.target
